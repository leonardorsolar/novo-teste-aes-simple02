{
  "format": "aes-cycle",
  "version": 1,
  "cycle": {
    "id": "novo_ciclo",
    "label": "Ciclo: novo-ciclo",
    "description": "",
    "approval": "stop_at_pr",
    "default_profile": "novo_ciclo"
  },
  "phases": [
    {
      "id": "fase_discovery",
      "label": "Fase: Discovery",
      "column": "In Progress"
    },
    {
      "id": "design",
      "label": "Design",
      "column": "In Progress"
    },
    {
      "id": "build",
      "label": "Build",
      "column": "In Progress"
    },
    {
      "id": "verify",
      "label": "Verify",
      "column": "In Review"
    },
    {
      "id": "deliver",
      "label": "Deliver",
      "column": "In Review"
    }
  ],
  "approval_modes": {
    "stop_at_pr": {
      "label": "Para no PR",
      "pause_after": [
        "pr"
      ]
    }
  },
  "steps": {
    "intake": {
      "phase": "fase_discovery",
      "label": "Intake",
      "run": {
        "agent": "intake"
      },
      "reads": [
        "issue.md"
      ],
      "writes": "intake.md",
      "next": {
        "ACCEPT": "@next",
        "NEEDS-INFO": "@wait-author",
        "REJECT": "@rejected"
      }
    },
    "prd": {
      "phase": "fase_discovery",
      "label": "PRD",
      "run": {
        "agent": "prd (skill aes-create-prd)"
      },
      "reads": [
        "issue.md",
        "intake.md"
      ],
      "writes": "prd.md",
      "next": {
        "DONE": "@next",
        "BLOCKED": "@human"
      }
    },
    "techspec": {
      "phase": "design",
      "label": "Techspec",
      "run": {
        "agent": "doc-writer-techspec (skill aes-create-techspec)"
      },
      "reads": [
        "issue.md",
        "intake.md",
        "prd.md"
      ],
      "writes": "techspec.md",
      "next": {
        "DONE": "@next",
        "BLOCKED": "@human"
      }
    }
  },
  "profiles": {
    "novo_ciclo": {
      "label": "Ciclo: novo-ciclo",
      "steps": [
        "intake",
        "prd",
        "techspec"
      ]
    }
  }
}
